# General
ASPNETCORE_ENVIRONMENT=Development

# Database
ConnectionStrings__mealplannerDb=Host=localhost;Port=5432;Database=mealplannerDb;Username=postgres;Password=password

# Better Auth (hosted inside the SvelteKit frontend)
# Generate a strong random value, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=supersecretvaluekeepitsecret
# Canonical public origin of the SvelteKit app (used for cookies + JWT issuer)
BETTER_AUTH_URL=http://localhost:3000
# Stable audience claim embedded into JWTs; must match MealPlanner.Api's Authentication:Audience
BETTER_AUTH_JWT_AUDIENCE=mealplanner-api

# Google OAuth (social login via Better Auth)
# Create a Web OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anthropic (recipe ingredient import)
Anthropic__ApiKey=

# URLs
services__api__http__0=http://mealplannerApi:5000
VITE_API_URL=http://localhost:5000
